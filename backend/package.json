{
  "name": "quad-api",
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:tunnel": "node start-dev-with-tunnel.js",
    "tunnel": "ngrok http 4000",
    "build": "tsc",
    "build:production": "NODE_ENV=production tsc",
    "start": "node dist/server.js",
    "start:production": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest",
    "test:run": "vitest run --maxWorkers=2",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/express": "^1.7.46",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "file-type": "^22.0.1",
    "helmet": "^8.1.0",
    "mongoose": "^9.2.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.1.1",
    "sanitize-html": "^2.17.0",
    "socket.io": "^4.8.1",
    "svix": "^1.81.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.3"
  }
}
