# Server Configuration
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/quad

# Auth (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Indexes
SKIP_INDEX_CREATION=false

# CORS Config
FRONTEND_URL=http://localhost:5173
# Set to 1 only behind one trusted reverse proxy with direct access blocked.
TRUST_PROXY_HOPS=0
ENABLE_API_DOCS=false

# Rate Limiting
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=500
RATE_LIMIT_UPLOAD_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=60
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=120

# Server & Media Configuration
SERVER_TIMEOUT_MS=300000
UPLOAD_MAX_FILE_SIZE_BYTES=52428800
IMAGE_MAX_FILE_SIZE_BYTES=10485760
CLOUDINARY_TIMEOUT_MS=300000

# Socket.IO Configuration
SOCKET_PING_TIMEOUT_MS=60000
SOCKET_PING_INTERVAL_MS=25000
